<!DOCTYPE html>
<html>
<head>
  <title>Products</title>
  <link rel="stylesheet" href="/public/css/user.css">
</head>
<body>

<!-- NAVBAR -->
<%- include('./partials/navbar') %>

<main class="u-container">

  <!-- FILTER BAR -->
  <section class="u-filter-bar">
    <input id="u-search" class="u-search" type="text" placeholder="Search products…">

    <select id="u-cat" class="u-cat-select">
      <option value="all">All Categories</option>
      <% categories.forEach(c => { %>
        <option value="<%= c.id %>"><%= c.name %></option>
      <% }) %>
    </select>
  </section>

  <!-- PRODUCTS SECTION -->
  <section class="u-section">
    <div class="u-sec-title">Products</div>

    <div class="u-grid">
      <% products.forEach(p => { %>
        <div class="u-card"
          data-id="<%= p.id %>"
          data-name="<%= p.name %>"
          data-price="<%= p.price %>"
          data-image="<%= p.image %>"
          data-category="<%= p.category_id %>"
        >
          <% if (p.image) { %>
            <img src="/public/uploads/products/<%= p.image %>" class="u-img">
          <% } else { %>
            <div class="u-img" style="background:#ddd;"></div>
          <% } %>

          <div class="u-title"><%= p.name %></div>
          <div class="u-price">₱<%= p.price %></div>
        </div>
      <% }) %>
    </div>
  </section>

</main>

<!-- PRODUCT MODAL -->
<%- include('./modal_product') %>

<script src="/public/js/user/product-modal.js"></script>
<script src="/public/js/user/products.js"></script>
<script src="/public/js/user/badge.js"></script>

</body>
</html>
