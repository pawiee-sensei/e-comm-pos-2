<!DOCTYPE html>
<html>
<head>
  <title>Products</title>
  <link rel="stylesheet" href="/public/css/admin.css">
  <link rel="stylesheet" href="/public/css/products/products.css">
</head>
<body>

<!-- SIDEBAR -->
<%- include('../sidebar') %>

<!-- MAIN PANEL -->
<main id="panel-container">

  <!-- HEADER -->
  <section class="prod-header">
    <h1>Product Inventory</h1>
    <button id="btnAddProduct" class="btn-primary" type="button">+ Add Product</button>
  </section>

  <!-- METRICS -->
  <section class="metrics-bar">
    <div class="metric">
      <div class="m-title">Total</div>
      <div class="m-value"><%= metrics.total %></div>
    </div>
    <div class="metric">
      <div class="m-title">Low Stock</div>
      <div class="m-value"><%= metrics.low %></div>
    </div>
    <div class="metric">
      <div class="m-title">Out of Stock</div>
      <div class="m-value"><%= metrics.out %></div>
    </div>
    <div class="metric">
      <div class="m-title">Healthy</div>
      <div class="m-value"><%= metrics.healthy %></div>
    </div>
  </section>

  <!-- FILTER BAR -->
  <section class="prod-filters">
    <form method="GET" class="filters">
      <input type="text" name="search" value="<%= search %>" placeholder="Search products…" class="input">

      <select name="category_id" class="select">
        <option value="">All Categories</option>
        <% categories.forEach(c => { %>
          <option value="<%= c.id %>" <%= category_id == c.id ? 'selected' : '' %>><%= c.name %></option>
        <% }) %>
      </select>

      <button class="btn-secondary" type="submit">Apply</button>
    </form>
  </section>

  <!-- TABLE -->
  <section class="prod-table">
    <table>
      <thead>
        <tr>
          <th>Image</th>
          <th>Product</th>
          <th>Category</th>
          <th>Stock</th>
          <th>Price</th>
          <th>Status</th>
          <th class="action-col"></th>
        </tr>
      </thead>

      <tbody>
        <% products.forEach(p => { %>
          <tr data-id="<%= p.id %>">

            <td>
  <% if (p.image && p.image !== 'null') { %>
    <img src="/public/uploads/products/<%= p.image %>" class="p-img">
  <% } else { %>
    <div class="no-img">No Image</div>
  <% } %>
</td>


            <td class="p-name"><%= p.name %></td>
            <td><%= p.category_name %></td>

            <!-- LIVE UPDATE HOOK -->
            <td class="td-stock"><%= p.stock %></td>

            <td>₱<%= p.price %></td>

            <!-- LIVE UPDATE STATUS -->
            <td class="td-status">
              <% if (p.stock == 0) { %>
                <span class="status out">OUT</span>
              <% } else if (p.stock <= 5) { %>
                <span class="status low">LOW</span>
              <% } else if (p.stock <= 20) { %>
                <span class="status med">MED</span>
              <% } else { %>
                <span class="status good">GOOD</span>
              <% } %>
            </td>

            <td class="actions">
              <!-- REQUIRED BUTTON HOOK -->
              <button 
                class="btn-small stock btn-adjust"
                data-id="<%= p.id %>"
                data-name="<%= p.name %>"
              >Adjust Stock</button>
                <button
                  class="btn-small edit btn-edit"
                  data-id="<%= p.id %>"
                  data-name="<%= p.name %>"
                  data-price="<%= p.price %>"
                  data-stock="<%= p.stock %>"
                  data-category="<%= p.category_id !== null ? p.category_id : '' %>"
                  data-image="<%= p.image %>"
                >Edit</button>



              <form method="POST" action="/admin/products/delete/<%= p.id %>" class="inline">
                <button class="btn-small danger">Delete</button>
              </form>
            </td>

          </tr>
        <% }) %>
      </tbody>
    </table>
  </section>

  <!-- PAGINATION -->
  <% if (pages && pages > 1) { %>
  <div class="pagination">
    <% for (let i = 1; i <= pages; i++) { %>
      <a href="?page=<%= i %>" class="pg <%= i === page ? 'active' : '' %>"><%= i %></a>
    <% } %>
  </div>
  <% } %>

</main>

<!-- MODALS -->
<%- include('_modal_adjust') %>
<%- include('_modal_add') %>
<%- include('_modal_edit') %>

<!-- JS -->
<script src="/public/js/products/products.js"></script>

<div id="modal-backdrop" class="modal-backdrop hidden"></div>

</body>
</html>
