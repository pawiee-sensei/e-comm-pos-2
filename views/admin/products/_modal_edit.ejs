<div id="modal-edit" class="modal-wrapper hidden">
  <div class="modal-content">

    <!-- HEADER -->
    <div class="modal-header">
      <span class="modal-title">Edit Product</span>
      <button class="modal-close-x" data-close>&#10005;</button>
    </div>

    <!-- FORM BODY -->
    <div class="modal-body form-body">

      <div class="form-group">
        <label>Name</label>
        <input type="text" id="e-name" class="input" required>
      </div>

      <div class="form-group">
        <label>Price</label>
        <input type="number" id="e-price" class="input" required>
      </div>

      <div class="form-group">
        <label>Category</label>
        <select id="e-category" class="select">
          <<option value="">No Category</option>
<% categories.forEach(c => { %>
  <option value="<%= c.id %>"><%= c.name %></option>
<% }) %>
        </select>
      </div>

      <div class="form-group">
        <label>Replace Image (Optional)</label>
        <input type="file" id="e-image" class="input-file">
      </div>

    </div>

    <!-- FOOTER -->
    <div class="modal-footer">
      <button class="btn-secondary" data-close>Cancel</button>
      <button id="edit-submit" class="btn-primary">Save Changes</button>
    </div>

  </div>
</div>
