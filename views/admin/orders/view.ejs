<!DOCTYPE html>
<html>
<head>
  <title>Order</title>
  <link rel="stylesheet" href="/public/css/admin.css">
</head>
<body>

<%- include('../sidebar') %>

<main id="panel-container">

  <div class="admin-page-header">
    <h1>Order #<%= order.id %></h1>
    <span class="badge <%= order.status %>">
      <%= order.status %>
    </span>
  </div>

  <div class="order-detail-grid">

    <!-- CUSTOMER -->
    <div class="order-box">
      <h3>Customer Information</h3>
      <p><strong>Name:</strong> <%= order.customer_name %></p>
      <p><strong>Phone:</strong> <%= order.phone %></p>
      <p><strong>Address:</strong><br><%= order.address %></p>
    </div>

    <!-- PAYMENT -->
    <div class="order-box">
      <h3>Payment</h3>
      <p><strong>Method:</strong> <%= order.payment_mode %></p>
      <p><strong>Status:</strong> <%= order.payment_status %></p>

      <% if (payment && payment.receipt_image) { %>
        <img
          src="/public/uploads/payments/<%= payment.receipt_image %>"
          class="receipt-img">
      <% } else { %>
        <p style="color:#777;">No receipt uploaded</p>
      <% } %>
    </div>

  </div>

  <!-- ITEMS -->
  <div class="order-box" style="margin-top:20px;">
    <h3>Order Items</h3>
    <table class="admin-table">
      <thead>
        <tr>
          <th>Product</th>
          <th>Qty</th>
          <th>Price</th>
          <th>Subtotal</th>
        </tr>
      </thead>
      <tbody>
        <% items.forEach(i => { %>
          <tr>
            <td><%= i.name %></td>
            <td><%= i.qty %></td>
            <td>₱<%= i.price %></td>
            <td>₱<%= i.subtotal %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>

  <!-- ACTIONS -->
  <% if (order.status === 'pending') { %>
  <div class="order-actions">
    <form method="POST" action="/admin/orders/<%= order.id %>/confirm">
      <button class="btn-primary">Confirm Order</button>
    </form>

    <form method="POST" action="/admin/orders/<%= order.id %>/cancel">
      <button class="btn-small danger">Cancel</button>
    </form>
  </div>
  <% } %>

</main>

<script src="/public/js/admin.js"></script>
</body>
</html>
