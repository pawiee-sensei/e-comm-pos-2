<!DOCTYPE html>
<html>
<head>
  <title>Strategy</title>
  <link rel="stylesheet" href="/public/css/admin.css">
  <link rel="stylesheet" href="/public/css/admin.strategy.css">
</head>
<body>

<%- include('../sidebar') %>

<main id="panel-container">

  <!-- METRICS -->
  <section class="strategy-metrics">
    <div class="metric-card">
      <div class="metric-label">Revenue</div>
      <div class="metric-value">₱<%= Number(metrics.revenue).toFixed(2) %></div>
    </div>

    <div class="metric-card">
      <div class="metric-label">Gross Profit</div>
      <div class="metric-value">₱<%= Number(metrics.gross_profit).toFixed(2) %></div>
    </div>

    <div class="metric-card">
      <div class="metric-label">Avg Margin</div>
      <div class="metric-value"><%= avgMargin %>%</div>
    </div>

    <div class="metric-card">
      <div class="metric-label">Decision Confidence</div>
      <div class="metric-value"><%= confidence %></div>
    </div>
  </section>

  <!-- FILTER -->
  <form method="GET" class="strategy-filter">
    <select name="period">
      <option value="1" <%= period==1?'selected':'' %>>Today</option>
      <option value="7" <%= period==7?'selected':'' %>>7 Days</option>
      <option value="30" <%= period==30?'selected':'' %>>30 Days</option>
    </select>
    <button>Apply</button>
  </form>

  <!-- TABLE 1 -->
  <h3>Product Profit Performance</h3>
  <table class="strategy-table">
    <tr>
      <th>Product</th>
      <th>Sold</th>
      <th>Revenue</th>
      <th>Profit</th>
      <th>Margin %</th>
      <th>Stock</th>
      <th>Classification</th>
    </tr>
    <% salesImpact.forEach(p => { %>
      <tr>
        <td><%= p.name %></td>
        <td><%= p.units_sold %></td>
        <td>₱<%= p.revenue %></td>
        <td>₱<%= p.profit %></td>
        <td><%= p.margin %>%</td>
        <td><%= p.stock %></td>
        <td><%= p.classification %></td>
      </tr>
    <% }) %>
  </table>

  <!-- TABLE 2 -->
  <h3>Inventory Risk & Restock Planning</h3>
  <table class="strategy-table">
    <tr>
      <th>Product</th>
      <th>Stock</th>
      <th>Avg Daily</th>
      <th>Days Left</th>
      <th>Status</th>
    </tr>
    <% inventoryRisk.forEach(p => { %>
      <tr>
        <td><%= p.name %></td>
        <td><%= p.stock %></td>
        <td><%= p.avg_daily_sales %></td>
        <td><%= p.days_left %></td>
        <td><%= p.status %></td>
      </tr>
    <% }) %>
  </table>

  <!-- TABLE 3 -->
  <h3>Missed Revenue (Out of Stock with Demand)</h3>
  <table class="strategy-table">
    <tr>
      <th>Product</th>
      <th>Units Sold (Recent)</th>
      <th>Action</th>
    </tr>
    <% missed.forEach(p => { %>
      <tr>
        <td><%= p.name %></td>
        <td><%= p.units_sold %></td>
        <td>Immediate Restock</td>
      </tr>
    <% }) %>
  </table>

</main>


</body>
</html>
